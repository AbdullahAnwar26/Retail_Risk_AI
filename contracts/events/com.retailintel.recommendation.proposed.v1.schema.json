{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://retail-intel.invalid/contracts/events/v1/com.retailintel.recommendation.proposed.v1.schema.json",
  "title": "com.retailintel.recommendation.proposed.v1",
  "description": "New suggestion or credit referral. CREDIT_REFERRAL only means 'refer to the credit platform for assessment' and carries no eligibility, limit, rate or likelihood; this is the defined outbound referral handoff (planning/15 §11). No event type for credit decisions exists. Change log: 2026-11-09 created (PH-3, readiness P-4). 2026-11-10 (contract 1.2.0, V-9, file 20 SDC-11): optional `sharia_disclosure_required`. The event carries ids and summaries only, never the Sharia disclosure block; in an ISLAMIC deployment a consumer must not render a product suggestion or credit referral from this event alone but fetch the recommendation through the API, which carries `sharia_disclosure` (render refused if it is missing). Track A (CONVENTIONAL) events never carry the field. Second example: Track B demo.",
  "x-ri-output-class": "CUSTOMER_OUTCOME",
  "allOf": [
    {
      "$ref": "cloudevent-envelope.schema.json"
    }
  ],
  "type": "object",
  "properties": {
    "type": {
      "const": "com.retailintel.recommendation.proposed.v1"
    },
    "data": {
      "type": "object",
      "allOf": [
        {
          "$ref": "cloudevent-envelope.schema.json#/$defs/customerLabels"
        }
      ],
      "required": [
        "rec_id",
        "kind",
        "product_code",
        "requires_human_review",
        "allowed_channels",
        "decision_id"
      ],
      "properties": {
        "rec_id": {
          "$ref": "cloudevent-envelope.schema.json#/$defs/Identifier"
        },
        "kind": {
          "enum": [
            "PRODUCT_SUGGESTION",
            "SERVICE_SUGGESTION",
            "EDUCATIONAL_CONTENT",
            "CREDIT_REFERRAL"
          ]
        },
        "product_code": {
          "$ref": "cloudevent-envelope.schema.json#/$defs/ReferenceCode"
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "requires_human_review": {
          "type": "boolean"
        },
        "review_item_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "allowed_channels": {
          "type": "array",
          "items": {
            "$ref": "cloudevent-envelope.schema.json#/$defs/Channel"
          }
        },
        "referral_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision_id": {
          "$ref": "cloudevent-envelope.schema.json#/$defs/Identifier"
        },
        "sharia_disclosure_required": {
          "type": "boolean",
          "const": true,
          "description": "ISLAMIC deployments only: true on PRODUCT_SUGGESTION and CREDIT_REFERRAL events (the SDC-11 disclosure must be rendered from the API recommendation). Absent in CONVENTIONAL deployments."
        }
      }
    }
  },
  "required": [
    "subject"
  ],
